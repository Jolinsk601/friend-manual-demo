# V1.5: 环境变量示例（复制为 .env 即可，本地开发不需要）

# ============================================
# AI 模式
# ============================================
# mock: 本地演示，无需 Key（默认）
# deepseek: 真实调用 API（部署到公网时改这个）
AI_MODE=mock

# ============================================
# DeepSeek 配置（AI_MODE=deepseek 时必填）
# ============================================
# 从 https://platform.deepseek.com/api_keys 申请
# ⚠️ 严禁提交到 GitHub
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ============================================
# V1.5: 限流配置（仅 deepseek 模式生效，mock 模式不限流）
# ============================================
# 每个 IP 每天的最大调用次数
DAILY_SUMMARY_LIMIT=10
DAILY_MATCH_LIMIT=10
DAILY_CHAT_LIMIT=10

# ============================================
# 运行端口
# ============================================
PORT=5001
